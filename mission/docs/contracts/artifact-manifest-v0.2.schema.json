{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ao.mission.artifact-manifest.v0.2",
  "type": "object",
  "required": [
    "schema",
    "mission_id",
    "artifact_refs",
    "manifest_digest",
    "signature",
    "safe_to_execute",
    "executes_work",
    "approves_work"
  ],
  "properties": {
    "schema": { "type": "string", "const": "ao.mission.artifact-manifest.v0.2" },
    "mission_id": { "type": "string" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "ref", "content_ref", "digest"],
        "properties": {
          "schema": { "type": "string", "const": "ao.mission.artifact-ref.v0.1" },
          "ref": { "type": "string" },
          "content_ref": { "type": "string", "pattern": "^artifacts/sha256/[0-9a-f]{64}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "kind": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": { "type": "string" },
    "safe_to_execute": { "type": "boolean", "const": false },
    "executes_work": { "type": "boolean", "const": false },
    "approves_work": { "type": "boolean", "const": false },
    "generated_at_utc": { "type": "string" }
  },
  "additionalProperties": false
}
